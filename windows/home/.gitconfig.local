[user]
	# A separate, machine-generated signing key rather than the 1Password
	# GitHub key: native ssh-keygen.exe's -Y sign unconditionally requires
	# an agent for keys it didn't generate itself, even unencrypted ones,
	# and Git Bash's bundled ssh-keygen (MSYS2 build) can't parse the
	# 1Password-exported key format at all. A key generated by the same
	# tool that signs with it sidesteps both bugs. Added to GitHub as a
	# signing-only key via `gh ssh-key add --type signing`.
	signingkey = C:/Users/Nathan/.ssh/id_ed25519_signing

[gpg "ssh"]
	# Overrides common/home/.gitconfig's mac-only /opt/1Password/op-ssh-sign
	# path. Signs locally now, no 1Password involved.
	program = C:/Windows/System32/OpenSSH/ssh-keygen.exe
	allowedSignersFile = C:/Users/Nathan/.ssh/allowed_signers

[core]
	# Git Bash's bundled ssh (MSYS2 build) fails on the 1Password-exported
	# auth key with "error in libcrypto: unsupported"; the native Windows
	# OpenSSH client handles it fine.
	sshCommand = C:/Windows/System32/OpenSSH/ssh.exe
